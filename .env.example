APP_NAME=mini-RAG
APP_VERSION=0.1

FILE_ALLOWED_TYPES=["text/plain", "application/pdf"]
FILE_MAX_SIZE=10  # 10 MB
FILE_DEFAULT_CHUNK_SIZE=512000 # 512 KB

POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=minirag_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE=minirag

# ----------------------------- LLM CONFIGURATION -----------------------------

BACKEND_LITERALS=["OPENAI", "COHERE"]
GENERATION_BACKEND=OPENAI
EMBEDDING_BACKEND=OPENAI

OPENAI_API_KEY=Your-OpenAI-API-Key-Here
OPENAI_BASE_URL_Literal=["https://api.openai.com/v1", "http://localhost:11434/v1/"]
OPENAI_BASE_URL=http://localhost:11434/v1/ # for ollama models
COHERE_API_KEY=Your-Cohere-API-Key-Here

GENERATION_MODEL_ID_LITERALS=["gpt-3.5-turbo-0125", "llama3.2:1b"]
GENERATION_MODEL_ID=gpt-3.5-turbo-0125
EMBEDDING_MODEL_ID_LITERALS=["text-embedding-3-small", "embed-multilingual-light-v3.0"]
EMBEDDING_MODEL_ID=embed-multilingual-light-v3.0
EMBEDDING_MODEL_SIZE_LITERALS=[1536, 384]
EMBEDDING_MODEL_SIZE=384

INPUT_DEFAULT_MAX_CHARACTERS=1024
GENERATION_DEFAULT_MAX_TOKENS=200
GENERATION_DEFAULT_TEMPERATURE=0.1

# ----------------------------- Vector DB CONFIGURATION -----------------------------

VECTOR_DB_LITERALS=["QDRANT", "PGVECTOR"]
VECTOR_DB_BACKEND=QDRANT
QDRANT_DB_PATH=./qdrant_db
VECTOR_DB_DISTANCE_METHOD=cosine
VECTOR_DB_PGVECTOR_INDEX_THREADHOLD=500

# ----------------------------- Template Configuration -----------------------------

PRIMARY_LANGUAGE=en
DEFAULT_LANGUAGE=en
